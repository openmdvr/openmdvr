# Copy to infra/.env (never commit infra/.env) and fill in your own values for
# local development. In production, set these as environment variables in
# your deployment tool, never in a file inside the repository.

POSTGRES_SUPERUSER_PASSWORD=
APP_USER_PASSWORD=
# Postgres pool size for the Go server (JT808 + GT06 + video ingestion for
# ALL tenants). Default 16.
# PG_MAX_CONNS=16
ZLM_API_SECRET=
# Optional: public IP announced to JT808 devices for their video connection
# (0x9101). Leave empty (127.0.0.1) for local dev.
JT808_PUBLIC_IP=
# Signs the JWTs issued by the API. Long random string, never shared between
# dev/staging/production.
JWT_SECRET=
# Pepper for hashing integration API keys (see api/README.md). Long random
# string, intentionally DIFFERENT from JWT_SECRET so a leak of one does not
# compromise the other auth mechanism.
API_KEY_PEPPER=

# --- Production only (local dev: leave empty, safe defaults apply) ---
#
# Interface docker binds for device/dashboard/API ports (JT808 8808, JT1078
# 8081, GT06 5023, API 8000, dashboard 5175, video 80). Empty = 127.0.0.1
# (nothing reachable from outside the host, safe by default). In production:
# 0.0.0.0, with real exposure controlled by the cloud firewall (only device
# ports + dashboard/API open; never Postgres or the bridge's internal 8082).
PUBLIC_BIND_HOST=
# URL template the browser uses to play video. Must be the server's public IP
# or domain, NEVER 127.0.0.1 in production. Single %s placeholder; see
# ZLM_PLAY_URL_FORMAT in jt808-server/internal/config. The port must match
# ZLM_HTTP_PORT below (if not 80), unless a TLS domain is used (see the note
# at the end), in which case point it at the domain + path.
# Example without a domain: http://203.0.113.10:8090/rtp/%s.live.flv
ZLM_PLAY_URL_FORMAT=
# HOST port for ZLMediaKit HTTP (HTTP-FLV). Empty = 80. If a reverse proxy
# already owns host port 80, use another port (e.g. 8090) and reflect it in
# ZLM_PLAY_URL_FORMAT. Behind a domain, the browser never uses this port (the
# proxy talks to the container's internal port 80; see ZLM_BASE_URL in
# docker-compose.yml).
ZLM_HTTP_PORT=
# ZLMediaKit apiDebug: empty = 1 (local dev, logs every request). Set to 0 in
# production: apiDebug=1 logs the full query string, including the one-time
# video playback ticket.
ZLM_API_DEBUG=

# --- GT06 video dashcams (JIMI JC261/JC400: GT06 telemetry + RTMP push) ---
#
# RTMP "app" name these dashcams publish under (sent to the device with the
# RSERVICE command "<host>/<GT06_VIDEO_APP>"). Empty = "live". Intentionally
# different from "rtp" (the JT1078 app) so both video pipelines never share a
# stream namespace in ZLMediaKit.
GT06_VIDEO_APP=
# Public base URL (scheme+host, NO trailing slash, no %s) used to build the
# playback URL of a gt06_video stream. Unlike ZLM_PLAY_URL_FORMAT (a template),
# the real app/stream is only confirmed by on_publish once the device starts
# publishing. Empty = http://127.0.0.1 (local dev). In production: the public
# IP/domain, same base as ZLM_PLAY_URL_FORMAT, NEVER 127.0.0.1. The RTMP port
# the DEVICE publishes to (1935/tcp) must be open in the cloud firewall.
ZLM_GT06_PLAY_BASE_URL=
# Base URL the DASHBOARD (production Vite build) uses to call the API. Baked
# into the build; changing it requires rebuilding the image.
# Example without a domain: http://203.0.113.10:8000
VITE_API_BASE_URL=

# --- Alarm video clip retrieval (GT06 dashcams) ---
#
# Public base URL (scheme+host, NO trailing slash) configured on the device
# (UPLOAD/FILELIST commands) so it can upload recorded clips. Must be
# reachable from the device's cellular network. Empty = http://127.0.0.1:8083
# (local dev). In production: http://<public-ip-or-domain>:8083 (open
# 8083/tcp in the cloud firewall).
ALARM_CLIP_PUBLIC_BASE_URL=
# Max concurrent connections to public port 8083 (each upload may buffer up
# to 100MB in RAM). Empty = 200.
ALARM_CLIP_MAX_CONNECTIONS=
# S3-compatible storage (e.g. Cloudflare R2) for video clips. Shared by
# jt808-server (uploads the .ts) and api (signs short-lived read URLs): same
# bucket and credentials in both services. Empty = the feature is disabled
# with a clear error instead of breaking the rest of the system. Configure a
# lifecycle rule on the bucket (e.g. delete after 30 days) for keys under
# tenants/*/alarm-clips/*. Use a token scoped to object read/write on this
# bucket only.
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# --- Live video over WebRTC (playback transport; ingestion via JT1078/RTMP
# is unchanged) ---
#
# Public IP advertised to clients in ICE candidates. Without it ZLMediaKit
# advertises its internal Docker IP and video never connects even though SDP
# signaling succeeds.
#
# Never leave it empty, even in dev: with Docker Desktop, auto-detection
# advertises the container's internal IP, unreachable from the host browser.
# Local dev: 127.0.0.1 (port 8880 is published there). Production: the
# server's public IP. Port 8880 UDP+TCP (WebRTC media, never proxied) must be
# open in the cloud firewall.
ZLM_EXTERN_IP=127.0.0.1
# Public base URL (scheme+host, NO trailing slash) the BROWSER uses for WebRTC
# signaling. Behind a domain, reuse the same reverse-proxy rule that exposes
# /media/* to zlmediakit:80. Empty = http://127.0.0.1 (local dev).
# Production with a domain: https://portal.example.com/media
ZLM_WEBRTC_PLAY_BASE_URL=

# --- Domain + TLS (optional, recommended for production) ---
#
# Any reverse proxy with automatic TLS (Traefik, Caddy, nginx, or a PaaS such
# as Dokploy) can serve the three HTTP services from one domain with path
# routing:
#   Host: portal.example.com  Path: /       -> service "web"        port 80
#   Host: portal.example.com  Path: /api    -> service "api"        port 8000 (strip prefix)
#   Host: portal.example.com  Path: /media  -> service "zlmediakit" port 80   (strip prefix)
# Then: VITE_API_BASE_URL=https://portal.example.com/api
#       ZLM_PLAY_URL_FORMAT=https://portal.example.com/media/rtp/%s.live.flv
# JT808/JT1078/GT06 (raw TCP from field devices, never HTTP) stay published
# directly on IP:port regardless.

# ---------------------------------------------------------------------------
# Capacity and operational limits. Leave empty to use the default shown.
# They are safety caps, not design limits: tune them to your hardware and
# fleet size (see docs/scalability.md).
# ---------------------------------------------------------------------------
# Device server: concurrent TCP connections per listener.
# JT808_MAX_CONNECTIONS=5000
# JT1078_MAX_CONNECTIONS=5000
# GT06_MAX_CONNECTIONS=5000
# Open-file limit of the device server container. Must be above the sum of
# the connection caps above.
# DEVICE_SERVER_NOFILE=65536
# API: database connections per process. Keep (API processes x this) +
# PG_MAX_CONNS below PostgreSQL max_connections (default 100).
# API_DB_POOL_MAX_SIZE=10
# API rate limits, requests per minute.
# API_KEY_RATE_LIMIT_PER_MINUTE=120   (per API key)
# API_KEY_FAIL_RATE_LIMIT_PER_MINUTE=200   (per IP, invalid keys)
# ROUTE_HISTORY_RATE_LIMIT_PER_MINUTE=30   (per user)
# SNAPSHOT_RATE_LIMIT_PER_MINUTE=12   (per device)
# WEBHOOK_TEST_RATE_LIMIT_PER_MINUTE=10   (per user)
# Reports and heavy queries.
# REPORT_QUERY_TIMEOUT_MS=8000
# ROUTE_HISTORY_MAX_DAYS=31
# ROUTE_HISTORY_MAX_POINTS=3000
# ROUTE_HISTORY_MAX_EVENTS=500
# DISTANCE_REPORT_MAX_DAYS=31
# HOURS_REPORT_MAX_DAYS=31
# GEOFENCE_REPORT_MAX_DAYS=93
# GEOFENCE_REPORT_MAX_VISITS=2000
# Outbound webhooks.
# WEBHOOK_MAX_ENDPOINTS_PER_TENANT=10
# WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
# WEBHOOK_MAX_ATTEMPTS=6
# WEBHOOK_MAX_CONCURRENT_DELIVERIES=10
